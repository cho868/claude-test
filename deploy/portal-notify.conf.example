# /etc/portal-notify.conf へコピーして編集する。
#   sudo cp deploy/portal-notify.conf.example /etc/portal-notify.conf
#   sudo vi /etc/portal-notify.conf
# notify.sh がこのファイルを読み込みます。
#
# 🍓 ラズパイ+Tailscale構成の場合の推奨値:
#   DOMAIN=""                → certbot不使用(HTTPSはTailscaleが自動更新)なので空
#   SITE_URL="https://xxx.ts.net"  → Funnelの公開URL
#   TRIAL_END="none"         → 体験期限が無いので非表示
#   REAUTH_INTERVAL_HOURS="" / REAUTH_INTERVAL_DAYS="none" → 更新作業が無いので非表示
#   NOIP_LAST_CONFIRMED="none" → no-ip不使用なら非表示

# Discord の Webhook URL（チャンネル設定 → 連携サービス → ウェブフック で作成）
DISCORD_WEBHOOK="https://discord.com/api/webhooks/xxxxxxxx/xxxxxxxx"

# 公開ドメイン（certbotのSSL証明書の残り日数チェックに使用。certbot不使用なら空）
DOMAIN="madgear.sytes.net"
SITE_URL="https://madgear.sytes.net"

# 体験終了日（分かれば YYYY-MM-DD。期限のない環境(ラズパイ等)は "none" で非表示）
TRIAL_END=""

# 認証間隔（日）: 旧仕様用。下の HOURS を設定するとそちらが優先される
REAUTH_INTERVAL_DAYS="4"

# 有効期限（時間）: 24時間で終了する契約なら "24"。
# 更新できるのは期限の RENEW_WINDOW_HOURS 時間前から（XServerは12時間前）。
# 更新できない時間帯は鳴らさず、更新可能になってから通知する。
# 更新のたびに sudo /var/www/portal/deploy/renewed.sh を実行すると正確になる。
REAUTH_INTERVAL_HOURS="24"
RENEW_WINDOW_HOURS="12"

# XServerの更新ページURL（リマインドに添付。実際の更新画面のURLに変えてもOK）
RENEW_PANEL_URL="https://secure.xserver.ne.jp/xapanel/login/xvps/"

# no-ip を最後に確認した日（YYYY-MM-DD）。23日目に🟠・27日目に🔴@everyone。
# 確認するたびに手で書くか、 sudo deploy/noip-confirmed.sh を実行すると今日付で自動記録。
# no-ip を使わない構成では "none" で非表示
NOIP_LAST_CONFIRMED=""

# healthchecks.io の ping URL（無料登録 → Check 作成で取得。死活監視。任意）
HEALTHCHECK_URL=""

# 通知に出す名前
HOST_LABEL="身内ポータル"

# LINE 通知（任意）: Messaging API のチャネルアクセストークン。Botを友だち追加した人全員に届く
LINE_TOKEN=""
# LINEは無料枠が月200通(配信数×友だち人数)。1=緊急時のみ送る(推奨)。0=毎回送る
# 毎朝の「稼働中✅」までLINEに流すと枠を使い切って月末まで届かなくなる
LINE_URGENT_ONLY="1"
# LINEはこの分数より短い間隔では送らない(無料枠を守る間引き)。Discordは全部残る。
# 期限1時間前の10分ごと連打もLINEは30分に1通に間引かれる。増やしたいなら数字を下げる
LINE_MIN_INTERVAL_MIN="30"

# メモリ使用率アラートのしきい値（%。これ以上でDiscord/LINEに警告）
MEM_ALERT_THRESHOLD="85"

# ===== アクセス異常検知（access-monitor.sh 用）=====
# 「身内しか使わないのに大量アクセス＝異常」の検知しきい値（10分あたり）
ACCESS_REQS_ALERT="300"    # リクエスト数がこれ超で異常
ACCESS_IPS_ALERT="10"      # ユニークIP数がこれ超で異常（身内は数人のはず）
ACCESS_404_ALERT="40"      # 404がこれ超で異常（探索行為の兆候）
ACCESS_SCAN_ALERT="10"     # wp-login/.env等の攻撃風パスがこれ超で異常(弾けていれば通知は@everyoneなし)
ACCESS_LOGIN_ALERT="30"    # ログイン試行がこれ超で@everyone(総当たりの疑い)
# ※ 攻撃系パスが2xxを返した場合は件数に関係なく即@everyone(実害の可能性)

# ===== SDカード週次レポート（sd-health.sh 用・ラズパイ）=====
# 寿命目安の前提となる総書込許容量(TB)。メーカー非公開のため超概算。
# 32GB級の一般カード=10 / 高耐久(High Endurance)なら 20〜 が目安
SD_TBW_EST_TB="10"
# 監視するデバイス名。SD起動=mmcblk0 / USB-SSD起動=sda
SD_DEVICE="mmcblk0"

# ===== オフサイト・バックアップ（backup-to-discord.sh 用）=====
# DBを毎日Discordへ退避してVPS全損に備える。守るべきはDBファイル。
# バックアップ専用チャンネルのWebhook（空なら上の DISCORD_WEBHOOK を流用）
BACKUP_WEBHOOK=""
# 暗号化パスフレーズ（ユーザーデータをDiscordに置くため設定を強く推奨）。
# ※このパスフレーズは復元に必須。パスワードマネージャ等でVPSの外に控えること
BACKUP_PASSPHRASE=""
